# Leave these unset to run Plug on its built-in demo backend (seeded data in the
# browser, no account needed). That is how the public deployment runs.
#
# Set both to point the same app at a real Supabase project. The SQL to create
# the schema is in create-complete-schema.sql; see DATABASE_SCHEMA_REFERENCE.md.
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_ANON_KEY=

# Force demo mode even when Supabase credentials are present.
# REACT_APP_DEMO_MODE=true
