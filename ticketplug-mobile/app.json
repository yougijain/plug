{
  "expo": {
    "name": "TicketPlug",
    "slug": "ticketplug",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#4F46E5"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ticketplug.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "TicketPlug needs access to your camera to take photos of tickets you're selling.",
        "NSPhotoLibraryUsageDescription": "TicketPlug needs access to your photo library to select ticket images.",
        "NSPhotoLibraryAddUsageDescription": "TicketPlug needs access to save images to your photo library."
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.ticketplug.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#4F46E5"
      },
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "READ_MEDIA_IMAGES"
      ],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "TicketPlug needs access to your photos to select ticket images.",
          "cameraPermission": "TicketPlug needs access to your camera to take photos of tickets."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "your-project-id-here"
      }
    }
  }
}
